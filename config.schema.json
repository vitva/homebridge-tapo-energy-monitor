{
  "pluginAlias": "TapoEnergyMonitor",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Multi-device simulator. All readings are simulated; real Tapo communication is not implemented.",
  "footerDisplay": "Data is stored locally on the Homebridge host. Optional Matter export publishes the simulated aggregate as estimated energy.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform name",
        "type": "string",
        "default": "Tapo Energy Monitor"
      },
      "simulationMode": {
        "title": "Simulation mode",
        "type": "boolean",
        "default": true,
        "description": "Keep enabled until real Tapo integration is implemented."
      },
      "enableMatterMeter": {
        "title": "Publish Matter energy sensor",
        "type": "boolean",
        "default": true,
        "description": "Requires Matter enabled on this Homebridge bridge and Homebridge 2.2.0 or later. Publishes estimated totals only; real Tapo counters will be a separate meter."
      },
      "matterMeterName": {
        "title": "Matter sensor name",
        "type": "string",
        "default": "Tapo Energy — Расчётная"
      },
      "pollingIntervalSeconds": {
        "title": "Polling interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 30,
        "maximum": 3600
      },
      "simulatedPowerW": {
        "title": "Simulated power (W)",
        "type": "number",
        "default": 450,
        "minimum": 0,
        "maximum": 5000,
        "description": "Fallback power for the single demo device when Simulated devices is empty."
      },
      "dataDirectory": {
        "title": "Data directory (optional)",
        "type": "string",
        "default": "",
        "description": "Leave empty to use the Homebridge storage directory."
      },
      "simulatedDevices": {
        "title": "Simulated devices",
        "type": "array",
        "description": "Add one row per test device. These are simulated readings, not physical Tapo devices.",
        "items": {
          "type": "object",
          "title": "Device",
          "properties": {
            "id": {
              "title": "Unique device ID",
              "type": "string"
            },
            "name": {
              "title": "Display name",
              "type": "string"
            },
            "model": {
              "title": "Model",
              "type": "string",
              "enum": [
                "P110M",
                "S112",
                "S110E",
                "Other"
              ],
              "default": "P110M"
            },
            "powerW": {
              "title": "Simulated power (W)",
              "type": "number",
              "minimum": 0,
              "maximum": 5000,
              "default": 100
            }
          },
          "required": [
            "id",
            "name",
            "powerW"
          ]
        },
        "default": [
          {
            "id": "demo-p110m",
            "name": "Demo P110M",
            "model": "P110M",
            "powerW": 450
          },
          {
            "id": "demo-s112",
            "name": "Demo S112",
            "model": "S112",
            "powerW": 120
          },
          {
            "id": "demo-s110e",
            "name": "Demo S110E",
            "model": "S110E",
            "powerW": 60
          }
        ]
      }
    },
    "required": [
      "name",
      "simulationMode",
      "pollingIntervalSeconds",
      "simulatedPowerW"
    ]
  },
  "form": null,
  "display": null,
  "customUi": true
}
